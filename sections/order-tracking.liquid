{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .order-tracking__wrapper {
    max-width: 68rem;
    margin: 0 auto;
  }

  .order-tracking__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .order-tracking__text {
    margin-top: 0.8rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .order-tracking__cta {
    text-align: center;
    margin-bottom: 4rem;
  }

  .order-tracking__cta .button {
    min-width: 24rem;
  }

  .order-tracking__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.8rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 750px) {
    .order-tracking__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .order-tracking__step {
    text-align: center;
  }

  .order-tracking__step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background: rgba(27, 75, 92, 0.08);
    color: #1b4b5c;
    margin-bottom: 1.2rem;
  }

  .order-tracking__step-icon svg {
    width: 2.6rem;
    height: 2.6rem;
  }

  .order-tracking__step-heading {
    margin: 0 0 0.4rem;
  }

  .order-tracking__step-text {
    margin: 0;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  .order-tracking__support {
    text-align: center;
    padding-top: 2.8rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.1);
  }

  .order-tracking__support p {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .order-tracking__support a {
    color: #1b4b5c;
    text-decoration: underline;
  }
{%- endstyle -%}

<div class="order-tracking-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="order-tracking__wrapper">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="order-tracking__header">
          {%- if section.settings.heading != blank -%}
            <h1 class="order-tracking__heading rte inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h1>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="order-tracking__text rte">
              {{ section.settings.subheading }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="order-tracking__cta">
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}

      <div class="order-tracking__steps">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'step' -%}
              <div class="order-tracking__step" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="order-tracking__step-icon">
                    {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="order-tracking__step-heading h5">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="order-tracking__step-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.support_text != blank -%}
        <div class="order-tracking__support">
          <p class="rte">{{ section.settings.support_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.order_tracking.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Track Your Order",
      "label": "t:sections.order_tracking.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Enter your order details below to see the latest status, or sign in to view tracking for all your orders.</p>",
      "label": "t:sections.order_tracking.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Track My Order",
      "label": "t:sections.order_tracking.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.order_tracking.settings.button_link.label",
      "info": "t:sections.order_tracking.settings.button_link.info"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "default": "<p>Can't find your tracking info? Check the shipping confirmation email sent to the address you used at checkout (don't forget to check spam). Still stuck? Email us at <a href=\"mailto:relorgroup@gmail.com\">relorgroup@gmail.com</a>.</p>",
      "label": "t:sections.order_tracking.settings.support_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.order_tracking.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.order_tracking.blocks.step.settings.icon.label",
          "info": "t:sections.order_tracking.blocks.step.settings.icon.info",
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.order_tracking.blocks.step.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.order_tracking.blocks.step.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.order_tracking.presets.name",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
