{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .feature-highlights__wrapper {
    max-width: 68rem;
    margin: 0 auto;
  }

  .feature-highlights__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .feature-highlights__subheading {
    margin-top: 0.8rem;
  }

  .feature-highlights__subheading strong {
    color: #1b4b5c;
  }

  .feature-highlights__list {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
    margin-bottom: 3.2rem;
  }

  .feature-highlights__item {
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
  }

  .feature-highlights__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    color: #1b4b5c;
  }

  .feature-highlights__icon svg {
    width: 2.8rem;
    height: 2.8rem;
  }

  .feature-highlights__item-heading {
    margin: 0 0 0.4rem;
  }

  .feature-highlights__item-text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .feature-highlights__button.button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    text-align: center;
  }
{%- endstyle -%}

<div class="feature-highlights-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="feature-highlights__wrapper">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="feature-highlights__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="feature-highlights__heading rte inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="feature-highlights__subheading rte inline-richtext">
              {{ section.settings.subheading }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="feature-highlights__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="feature-highlights__item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="feature-highlights__icon">
                    {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                <div class="feature-highlights__item-content">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="feature-highlights__item-heading h4">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="feature-highlights__item-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="feature-highlights__button button button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feature_highlights.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "RelorGuard&reg; Anti-Snoring Mouthpiece",
      "label": "t:sections.feature_highlights.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "default": "Over <strong>2,600+</strong> Happy Customers!",
      "label": "t:sections.feature_highlights.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Get 50% Off Today",
      "label": "t:sections.feature_highlights.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.feature_highlights.settings.button_link.label",
      "info": "t:sections.feature_highlights.settings.button_link.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.feature_highlights.blocks.feature.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.feature_highlights.blocks.feature.settings.icon.label",
          "info": "t:sections.feature_highlights.blocks.feature.settings.icon.info",
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.feature_highlights.blocks.feature.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.feature_highlights.blocks.feature.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feature_highlights.presets.name",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
