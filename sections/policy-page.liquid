{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign page_content_stripped = page.content | strip_html | strip_newlines | strip -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>

  {%- if section.settings.last_updated != blank -%}
    <p class="policy-page-updated caption-with-letter-spacing">
      {{ 'sections.policy_page.last_updated' | t: date: section.settings.last_updated }}
    </p>
  {%- endif -%}

  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if page_content_stripped != blank -%}
      {{ page.content }}
    {%- elsif section.settings.policy_type == 'privacy' -%}
      {%- render 'policy-content-privacy' -%}
    {%- elsif section.settings.policy_type == 'shipping' -%}
      {%- render 'policy-content-shipping' -%}
    {%- elsif section.settings.policy_type == 'returns' -%}
      {%- render 'policy-content-returns' -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.policy_page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "policy_type",
      "label": "t:sections.policy_page.settings.policy_type.label",
      "info": "t:sections.policy_page.settings.policy_type.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.policy_page.settings.policy_type.options__1"
        },
        {
          "value": "privacy",
          "label": "t:sections.policy_page.settings.policy_type.options__2"
        },
        {
          "value": "shipping",
          "label": "t:sections.policy_page.settings.policy_type.options__3"
        },
        {
          "value": "returns",
          "label": "t:sections.policy_page.settings.policy_type.options__4"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "t:sections.policy_page.settings.last_updated.label",
      "info": "t:sections.policy_page.settings.last_updated.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
