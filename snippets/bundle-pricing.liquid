{% comment %}
  Renders a 4-tier quantity bundle selector with its own Add to Cart button.
  Submits to the shared product form via the HTML `form` attribute, so it
  must be rendered on the same page as a `buy-buttons` block (hidden via
  CSS below) which owns the actual <form> and variant id input.

  Accepts:
  - product: {Object} product object.
  - block: {Object} block information (bundle_pricing block settings).
  - product_form_id: {String} id of the shared product form.
  - section: {Object} section object.

  Usage:
  {% render 'bundle-pricing', product: product, block: block, product_form_id: product_form_id, section: section %}
{% endcomment %}
{{ 'component-bundle-pricing.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /*
    The bundle-pricing block supplies its own Add to Cart button and submits
    to the same product form as the buy-buttons block (via the HTML `form`
    attribute), so the buy-buttons block's own button/quantity chrome is
    hidden here rather than duplicated. Its <form> and variant id input are
    still required and remain in the DOM.
  */
  #{{ product_form_id }} .product-form__buttons {
    display: none;
  }
{%- endstyle -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign unit_price = variant.price
  assign tier_indexes = '1,2,3,4' | split: ','
  assign selected_tier = 1

  # Subscribe & Save: only rendered when the product has an active selling
  # plan (created via a subscriptions app, e.g. Shopify Subscriptions).
  # Nothing to configure here — the toggle appears automatically once a
  # selling plan exists on the product, and stays hidden otherwise.
  assign has_selling_plans = false
  assign selling_plan_id = ''
  assign selling_plan_percent_off = 0
  if product.selling_plan_groups.size > 0
    assign selling_plan_group = product.selling_plan_groups.first
    assign selling_plan = selling_plan_group.selling_plans.first
    if selling_plan
      assign has_selling_plans = true
      assign selling_plan_id = selling_plan.id
      for adjustment in selling_plan.price_adjustments
        if adjustment.value_type == 'percentage'
          assign selling_plan_percent_off = adjustment.value | times: 1
        endif
      endfor
    endif
  endif
  assign subscribe_multiplier = 100 | minus: selling_plan_percent_off
  assign subscribe_subtitle = block.settings.subscribe_subtitle | default: 'Ships every month. Skip or cancel anytime.'

  # Fallback in case no tier is marked "selected by default" in settings.
  assign selected_quantity = block.settings.tier_1_quantity
  assign selected_submit_quantity = block.settings.tier_1_quantity
  assign fallback_original_total = unit_price | times: selected_quantity
  assign fallback_discount_multiplier = 100 | minus: block.settings.tier_1_discount
  assign fallback_current_total = fallback_original_total | times: fallback_discount_multiplier | divided_by: 100.0 | round
  if settings.currency_code_enabled
    assign selected_current_formatted = fallback_current_total | money_with_currency
    assign selected_original_formatted = fallback_original_total | money_with_currency
  else
    assign selected_current_formatted = fallback_current_total | money
    assign selected_original_formatted = fallback_original_total | money
  endif
-%}

<bundle-pricing
  class="bundle-pricing"
  data-form-id="{{ product_form_id }}"
  {{ block.shopify_attributes }}
>
  {%- if has_selling_plans -%}
    <div
      class="bundle-pricing__purchase-toggle"
      role="radiogroup"
      aria-label="{{ 'products.product.bundle_pricing.purchase_options' | t }}"
    >
      <label class="bundle-pricing__purchase-choice">
        <input
          type="radio"
          class="bundle-pricing__purchase-radio visually-hidden"
          name="PurchaseOption-{{ section.id }}"
          value="onetime"
          checked
        >
        <span class="bundle-pricing__purchase-card">
          <span class="bundle-pricing__radio-visual" aria-hidden="true"></span>
          <span class="bundle-pricing__purchase-info">
            <span class="bundle-pricing__purchase-label">
              {{- 'products.product.bundle_pricing.one_time_purchase' | t -}}
            </span>
          </span>
        </span>
      </label>
      <label class="bundle-pricing__purchase-choice">
        <input
          type="radio"
          class="bundle-pricing__purchase-radio visually-hidden"
          name="PurchaseOption-{{ section.id }}"
          value="subscribe"
          data-selling-plan-id="{{ selling_plan_id }}"
        >
        <span class="bundle-pricing__purchase-card">
          <span class="bundle-pricing__radio-visual" aria-hidden="true"></span>
          <span class="bundle-pricing__purchase-info">
            <span class="bundle-pricing__purchase-label">
              {{- 'products.product.bundle_pricing.subscribe_and_save' | t: percent: selling_plan_percent_off -}}
            </span>
            <span class="bundle-pricing__purchase-subtitle">{{ subscribe_subtitle }}</span>
          </span>
        </span>
      </label>
    </div>
    <input
      type="hidden"
      name="selling_plan"
      form="{{ product_form_id }}"
      class="bundle-pricing__selling-plan-input"
      value=""
    >
  {%- endif -%}

  <div class="bundle-pricing__tiers" role="radiogroup">
    {%- for i in tier_indexes -%}
      {%- liquid
        case i
          when '1'
            assign tier_quantity = block.settings.tier_1_quantity
            assign tier_label = block.settings.tier_1_label
            assign tier_discount = block.settings.tier_1_discount
            assign tier_perks = block.settings.tier_1_perks
            assign tier_selected = block.settings.tier_1_selected
            assign tier_option_value = block.settings.tier_1_option_value
          when '2'
            assign tier_quantity = block.settings.tier_2_quantity
            assign tier_label = block.settings.tier_2_label
            assign tier_discount = block.settings.tier_2_discount
            assign tier_perks = block.settings.tier_2_perks
            assign tier_selected = block.settings.tier_2_selected
            assign tier_option_value = block.settings.tier_2_option_value
          when '3'
            assign tier_quantity = block.settings.tier_3_quantity
            assign tier_label = block.settings.tier_3_label
            assign tier_discount = block.settings.tier_3_discount
            assign tier_perks = block.settings.tier_3_perks
            assign tier_selected = block.settings.tier_3_selected
            assign tier_option_value = block.settings.tier_3_option_value
          when '4'
            assign tier_quantity = block.settings.tier_4_quantity
            assign tier_label = block.settings.tier_4_label
            assign tier_discount = block.settings.tier_4_discount
            assign tier_perks = block.settings.tier_4_perks
            assign tier_selected = block.settings.tier_4_selected
            assign tier_option_value = block.settings.tier_4_option_value
        endcase

        assign tier_original_total = unit_price | times: tier_quantity
        assign tier_discount_multiplier = 100 | minus: tier_discount
        assign tier_current_total = tier_original_total | times: tier_discount_multiplier | divided_by: 100.0 | round

        # Default: submit the base variant with quantity = pack size.
        assign tier_variant_id = variant.id
        assign tier_submit_quantity = tier_quantity

        # When a tier is mapped to a real variant (matched by option value,
        # e.g. a supplier-provided "2PC" / "4pcs" pack SKU), submit that
        # variant directly with quantity 1 instead, so orders and inventory
        # reflect the correct pack SKU rather than N units of the base variant.
        # The displayed price is also switched to that variant's real price,
        # since that's what actually gets charged at checkout regardless of
        # what the discount setting above would otherwise compute.
        if tier_option_value != blank
          for tier_candidate_variant in product.variants
            if tier_candidate_variant.option1 == tier_option_value or tier_candidate_variant.option2 == tier_option_value or tier_candidate_variant.option3 == tier_option_value
              assign tier_variant_id = tier_candidate_variant.id
              assign tier_submit_quantity = 1
              assign tier_current_total = tier_candidate_variant.price
              break
            endif
          endfor
        endif

        if tier_selected
          assign selected_tier = i
        endif

        assign tier_subscribe_total = tier_current_total | times: subscribe_multiplier | divided_by: 100.0 | round

        if settings.currency_code_enabled
          assign tier_current_formatted = tier_current_total | money_with_currency
          assign tier_original_formatted = tier_original_total | money_with_currency
          assign tier_subscribe_formatted = tier_subscribe_total | money_with_currency
        else
          assign tier_current_formatted = tier_current_total | money
          assign tier_original_formatted = tier_original_total | money
          assign tier_subscribe_formatted = tier_subscribe_total | money
        endif

        assign tier_original_formatted_or_blank = ''
        if tier_discount > 0
          assign tier_original_formatted_or_blank = tier_original_formatted
        endif

        if tier_selected
          assign selected_current_formatted = tier_current_formatted
          assign selected_original_formatted = tier_original_formatted_or_blank
          assign selected_quantity = tier_quantity
          assign selected_submit_quantity = tier_submit_quantity
        endif
      -%}
      <label class="bundle-pricing__tier">
        <input
          type="radio"
          class="bundle-pricing__radio visually-hidden"
          name="BundleTier-{{ section.id }}"
          value="{{ tier_submit_quantity }}"
          data-onetime-formatted="{{ tier_current_formatted }}"
          data-subscribe-formatted="{{ tier_subscribe_formatted }}"
          data-original-formatted="{{ tier_original_formatted_or_blank }}"
          data-variant-id="{{ tier_variant_id }}"
          {% if tier_selected %}
            checked
          {% endif %}
        >
        <span class="bundle-pricing__card">
          {%- if tier_selected -%}
            <span class="bundle-pricing__ribbon">{{- 'products.product.bundle_pricing.most_popular' | t -}}</span>
          {%- endif -%}
          <span class="bundle-pricing__row">
            <span class="bundle-pricing__radio-visual" aria-hidden="true"></span>
            <span class="bundle-pricing__info">
              <span class="bundle-pricing__label">{{ tier_label }}</span>
              {%- if tier_perks != blank -%}
                <span class="bundle-pricing__subtitle">{{ tier_perks | strip_newlines | strip }}</span>
              {%- endif -%}
            </span>
            <span class="bundle-pricing__price">
              <span class="bundle-pricing__price-current">
                {%- if settings.currency_code_enabled -%}
                  {{- tier_current_total | money_with_currency -}}
                {%- else -%}
                  {{- tier_current_total | money -}}
                {%- endif -%}
              </span>
              {%- if tier_discount > 0 -%}
                <s class="bundle-pricing__price-original">
                  {%- if settings.currency_code_enabled -%}
                    {{- tier_original_total | money_with_currency -}}
                  {%- else -%}
                    {{- tier_original_total | money -}}
                  {%- endif -%}
                </s>
              {%- endif -%}
            </span>
          </span>
        </span>
      </label>
    {%- endfor -%}
  </div>

  <input
    type="hidden"
    name="quantity"
    form="{{ product_form_id }}"
    class="bundle-pricing__quantity-input"
    value="{{ selected_submit_quantity }}"
  >

  <button
    type="submit"
    form="{{ product_form_id }}"
    class="bundle-pricing__submit button button--primary button--full-width"
  >
    <span class="bundle-pricing__submit-text">
      {{- 'products.product.add_to_cart' | t -}}
      <span aria-hidden="true">•</span>
      <span class="bundle-pricing__submit-price">{{ selected_current_formatted }}</span>
      <s class="bundle-pricing__submit-original">{{ selected_original_formatted }}</s>
    </span>
    {%- render 'loading-spinner' -%}
  </button>

  {%- if block.settings.trust_text != blank -%}
    <p class="bundle-pricing__trust">{{ block.settings.trust_text }}</p>
  {%- endif -%}
</bundle-pricing>

<script src="{{ 'bundle-pricing.js' | asset_url }}" defer="defer"></script>
